@model IEnumerable<AlunosTech.Models.Tarefa>

@{
    ViewData["Title"] = "Gerenciamento de Tarefas";
}

<h2>Gerenciamento de Tarefas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nova Tarefa
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Descrição</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tarefa in Model)
        {
            <tr>
                <td>@tarefa.Titulo</td>
                <td>@tarefa.Descricao</td>
                <td>@tarefa.Status</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@tarefa.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
